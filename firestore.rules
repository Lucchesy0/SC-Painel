rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra para Solicitações de Compra (SC)
    match /scs/{scId} {
      allow read, write: if true;
    }

    // Regra para Equipamentos de TI (Inventário)
    match /equipments/{equipmentId} {
      allow read, write: if true;
    }

    // Regra para Usuários e Perfis
    match /users/{userId} {
      allow read, write: if true;
    }

    // Regra para Configurações do Sistema
    match /system_settings/{settingId} {
      allow read, write: if true;
    }

    // Default safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
